Vehicle:
  type: branch

Vehicle.GTA6:
  type: branch
  description: Grand Theft Auto VI community monitoring data.

Vehicle.GTA6.Community:
  type: branch
  description: Publicly observable indicators of GTA VI community activity.

Vehicle.GTA6.Community.Wikimedia:
  type: branch
  description: Wikimedia article readership statistics.

Vehicle.GTA6.Community.Wikimedia.Pageviews:
  datatype: uint64
  type: sensor
  description: Daily pageviews of the Grand Theft Auto VI Wikimedia article.

Vehicle.GTA6.Community.YouTube:
  type: branch
  description: YouTube video and livestream engagement statistics.

Vehicle.GTA6.Community.YouTube.VideoViews:
  datatype: uint64
  type: sensor
  description: Lifetime view count of a selected GTA VI related YouTube video.

Vehicle.GTA6.Community.YouTube.VideoLikes:
  datatype: uint64
  type: sensor
  description: Current like count of a selected GTA VI related YouTube video.

Vehicle.GTA6.Community.YouTube.LiveConcurrentViewers:
  datatype: uint64
  type: sensor
  description: Concurrent viewers reported for a selected public GTA VI livestream.
